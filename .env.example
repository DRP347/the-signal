# Local: npm run db:local creates this database. Supabase: use the session pooler URI.
DATABASE_URL=postgres://signal:signal_local_only@127.0.0.1:54329/signal
# Required only for POST /api/ingest; use at least 32 random characters.
INGEST_SECRET=
# Optional, increases GitHub's public API allowance. Never NEXT_PUBLIC_.
GITHUB_TOKEN=
# Optional OpenAI-compatible provider; AI remains OFF unless all are configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ENABLE_AI=false
# RSS metadata is limited to headlines by default; excerpts require publisher permission.
RSS_EXCERPTS=false
# Optional RSS source IDs approved by the operator (see docs/SOURCES.md).
EXTRA_RSS_SOURCES=
# Optional AWS service-specific official RSS feed URL copied from AWS Health.
AWS_STATUS_FEED=
INGEST_USER_AGENT=TheSignal/0.1 (personal technology briefing)

# Canonical origin; set to your domain only when deploying.
SITE_URL=http://localhost:3100
